{
  "name": "pg2hydra",
  "version": "0.1.0",
  "description": "Deterministic, resumable, FK-aware migration engine from Supabase Postgres to HydraDB. No LLM in the critical path.",
  "type": "module",
  "bin": {
    "pg2hydra": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "cli": "node --experimental-strip-types src/index.ts",
    "init": "npm run cli -- init",
    "plan": "npm run cli -- plan",
    "migrate": "npm run cli -- migrate",
    "status": "npm run cli -- status",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down -v",
    "bootstrap": "npm run cli -- bootstrap"
  },
  "dependencies": {
    "@hydradb/sdk": "^2.1.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.8.0"
  }
}
