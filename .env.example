# --- Source: Supabase Postgres -------------------------------------------------
# Use the SESSION POOLER string from Supabase (Project Settings -> Database ->
# Connection string -> Session pooler). The direct db.<ref>.supabase.co host is
# IPv6-only and unreachable from Codespaces, most CI runners, and many networks.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
PG_SCHEMA=public
PG_FORCE_IPV4=false      # true = prefer IPv4 when the host publishes both A and AAAA

# --- Target: HydraDB (API v2) --------------------------------------------------
HYDRA_BASE_URL=https://api.hydradb.com
HYDRA_DB_API_KEY=
HYDRA_DATABASE=my_database     # required on every v2 call (formerly tenant_id)
HYDRA_COLLECTION=              # optional partition (formerly sub_tenant_id)

# --- Throughput / backpressure -------------------------------------------------
BATCH_SIZE=1000          # rows read per keyset page
UPLOAD_CHUNK=20          # sources per ingest request (HydraDB max is 20)
CONCURRENCY=2            # in-flight ingest requests
REQUEST_DELAY_MS=1000    # pacing between ingest requests (documented guidance)
BATCH_DELAY_MS=0         # extra pause between source batches to spare the live DB
MAX_RETRIES=6
VERIFY=true              # poll /context/status to a terminal state before accepting rows
VERIFY_TIMEOUT_MS=300000

# --- Incremental sync ----------------------------------------------------------
SYNC_INTERVAL_SECONDS=60 # poll interval for `sync --watch`
SYNC_OVERLAP_SECONDS=5   # re-scan window, absorbs out-of-order commits
SYNC_DELETES=true        # reconcile deleted source rows into HydraDB deletes

# Restrict the run (comma separated). Empty = every base table in PG_SCHEMA.
TABLES=
SKIP_TABLES=
