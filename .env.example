# Source: local Postgres (pnpm db:up)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb
PG_SCHEMA=public

# Target: HydraDB
HYDRA_BASE_URL=https://api.hydradb.com
HYDRA_DB_API_KEY=
HYDRA_DATABASE=pg2hydra_demo
HYDRA_COLLECTION=

# Restrict the run (comma separated, empty = everything in PG_SCHEMA)
TABLES=
SKIP_TABLES=

# Layer routing (empty = automatic)
MEMORY_TABLES=
EPISODE_TABLES=
MIGRATE_MEMORIES=true

# Throughput
BATCH_SIZE=1000
DOC_TARGET_BYTES=24000
UPLOAD_CHUNK=20
CONCURRENCY=2
REQUEST_DELAY_MS=0
BATCH_DELAY_MS=0
MAX_RETRIES=6
REQUEST_TIMEOUT_SECONDS=60

# Waits and checks
BOOTSTRAP_TIMEOUT_MS=300000
VERIFY_TIMEOUT_MS=300000
VERIFY=true
WAIT_FOR_GRAPH=false
DECLARE_METADATA_SCHEMA=false
