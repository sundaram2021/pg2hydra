# --- Source: local Postgres (docker compose up -d) ------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb
PG_SCHEMA=public

# --- Target: HydraDB ------------------------------------------------------------
HYDRA_BASE_URL=https://api.hydradb.com
HYDRA_DB_API_KEY=
HYDRA_DATABASE=pg2hydra_demo
HYDRA_COLLECTION=

# --- Throughput / backpressure --------------------------------------------------
BATCH_SIZE=1000
UPLOAD_CHUNK=20
CONCURRENCY=2
REQUEST_DELAY_MS=1000
BATCH_DELAY_MS=0
MAX_RETRIES=6
REQUEST_TIMEOUT_SECONDS=60
BOOTSTRAP_TIMEOUT_MS=300000
BOOTSTRAP_POLL_MS=5000
HYDRA_SKIP_PREFLIGHT=false
VERIFY=true
VERIFY_TIMEOUT_MS=300000

# --- Incremental sync -----------------------------------------------------------
SYNC_INTERVAL_SECONDS=60
SYNC_OVERLAP_SECONDS=5
SYNC_DELETES=true

# Restrict the run (comma separated). Empty = every base table in PG_SCHEMA.
TABLES=
SKIP_TABLES=
