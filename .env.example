# --- Source: Supabase Postgres -------------------------------------------------
# Prefer a READ REPLICA connection string for the extractor when one exists.
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
PG_SCHEMA=public

# --- Target: HydraDB -----------------------------------------------------------
HYDRA_BASE_URL=https://api.hydradb.example.com
HYDRA_API_KEY=

# Endpoint paths (override if your deployment differs)
HYDRA_KNOWLEDGE_PATH=/upload/knowledge
HYDRA_MEMORY_PATH=/memories/add_memory
HYDRA_VERIFY_PATH=/ingestion/verify_processing

# --- Throughput / backpressure -------------------------------------------------
BATCH_SIZE=1000          # rows read per keyset page
UPLOAD_CHUNK=100         # documents per HydraDB request
CONCURRENCY=4            # in-flight HydraDB requests
BATCH_DELAY_MS=0         # pause between batches to spare the live DB
MAX_RETRIES=6
VERIFY=true              # poll verify_processing before finalising a checkpoint
VERIFY_TIMEOUT_MS=120000

# Restrict the run (comma separated). Empty = every base table in PG_SCHEMA.
TABLES=
SKIP_TABLES=
